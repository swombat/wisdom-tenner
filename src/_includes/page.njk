---
layout: base.njk
---
<article class="page-shell">
  <header class="page-header">
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if published and not hide_published %}<p class="published">{{ published | readableDate }}</p>{% endif %}
  </header>
  <div class="prose prose--essay">
    {{ content | safe }}
  </div>
</article>
