---
layout: base.njk
---
<article class="page-shell">
  <header class="page-header">
    {% if tags and "blog" in tags %}
      <p class="eyebrow">Thoughts</p>
    {% elif eyebrow %}
      <p class="eyebrow">{{ eyebrow }}</p>
    {% endif %}
    <h1>{{ title }}</h1>
    {% if not hide_published and (published or revisions or updated) %}
      <p class="published">
        {% if published %}First published: {{ published | readableDate }}{% endif %}
        {% if published and revisions %}<span aria-hidden="true"> · </span>{% endif %}
        {% if revisions %}Revised: {{ revisions }}{% endif %}
        {% if (published or revisions) and updated %}<span aria-hidden="true"> · </span>{% endif %}
        {% if updated %}Last updated: {{ updated | readableDate }}{% endif %}
      </p>
    {% endif %}
  </header>
  <div class="prose prose--essay">
    {{ content | safe }}
  </div>
</article>
