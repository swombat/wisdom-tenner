<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title and title != site.title %}{{ title }} · {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="#f4ebd7">
    <link rel="icon" type="image/png" href="/assets/uploads/brand/pen-nib-favicon.png">
    <link rel="stylesheet" href="/assets/css/site.css">
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-name" href="/">
          <img class="site-mark" src="/assets/uploads/brand/pen-nib-mark.png" alt="">
          <span class="site-name-text">
            <span>{{ site.title }}</span>
            <small>{{ site.tagline }}</small>
          </span>
        </a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
          Menu
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main navigation">
          {% for item in site.navigation %}
            <a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
          {% endfor %}
        </nav>
      </div>
    </header>

    <main id="content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <img class="footer-flourish" src="/assets/uploads/brand/flourish.png" alt="">
      <div>
        <p><strong>{{ site.title }}</strong> — {{ site.description }}</p>
      </div>
    </footer>
    <script src="/assets/js/site.js"></script>
  </body>
</html>
